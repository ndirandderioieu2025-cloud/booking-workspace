NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings > API. The publishable/anon key is designed for
# browser use and is protected by Row Level Security. Never add a service-role
# or secret key to a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only transactional email credential. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=your-resend-api-key
